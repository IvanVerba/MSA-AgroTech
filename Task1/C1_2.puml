@startuml C1_1
left to right direction

!include <C4/C4_Context>

title C1, вар.2: Мониторинг ферм с приоритетом централизованных вычислений

' Ферма
Enterprise_Boundary(система_фермы, "Ферма") {
 System(farm, \
        "Система мониторинга фермы\n[IoT+базовый HMI]",\
        "Приём данных с устройств, Обработка базовых (критичных) показателей,\
          Передача видео-аудио потока и сырых данных в центр для распознавания и обработки,\
          Обнаружение потери и восстановления связи с цетром (переключение в автономный режим),\
          Базовое отображение показателей/событий/инцидентов, Оповещения персонала,\
          Трекинг особей (перспектива), Базовое управление устройствами и кормлением при автономном режиме,\
          Передача разобранных базовых аналитик в центр, Получение и выполнение команд/настроек из центра")

 Person(employee, "Сотрудник (оператор, животновод, техник)", "Работает на ферме")

 System_Ext(extr_comm, "Система экстренных оповещений",\
                       "Push SMS Радио Телефон Сигнализация Сирена Ракетница Гонец Голубь")
 System_Ext(vcam, "Видеомониторинг животных\n[IoT]", "Видеонаблюдение, Видеорегистрация")
 System_Ext(rfid, "RFID-мониторинг животных\n[IoT]",\
                  "Поголовный трекинг чипированных особей", "Возможная перспектива")
 System_Ext(sensors, "Мониторинг параметров среды\n[IoT]",\
                     "Съём показаний датчиков (климат, вода, воздух, фильтры, кормохранилища и др.)")
 System_Ext(feeding, "Кормушки и поилки\n[PLC]", "Управление кормушками/поилками")

 Rel(extr_comm, employee , "Экстренные оповещения (инциденты животных, сбои техники, переход в автоном)")
 Rel(vcam, farm, "Предоставляет данные видеомониторинга животных")
 Rel(sensors, farm, "Предоставляет данные мониторинга среды")
 Rel(rfid, farm, "Предоставляет данные RFID-мониторинга животных")
 Rel(farm,feeding,"Управляет кормлением")
 Rel(employee, farm, "Авторизуется, работает на ферме с использованием системы")
 Rel(farm,extr_comm,"Оповещает сотрудников")
}


' Центральная платформа / головной офис
Enterprise_Boundary(система, "Центральная платформа (головной офис)") {
  System(center_farm,\
         "Центральное управление свинофермами\n[MES+AI+HMI]",\
         "Получение данных с ферм, Обработка сырых данных,\
           Распознавание состояний животных и инцидентов (инференс модели AI),\
           Запись полученных данных в хранилища,\
           Снятие/визуализация отчётов, Текущий учёт (планирование/прогноз/учёт поголовья, продукции, кормов),\
           Управление фермами (команды, настройки), API(web/mobile)")

  Person(mainuser, "Управляющий фермой (зоотехник, менеджер)", "Управляет фермой")
  Person(admin, "Сисадмин\n<reused>", "Обновление ПО систем, Техподдержка систем, Настройка доступа")

  System_Ext(erp,\
             "1С:Агро\n[ERP]",\
             "Склад, Учёт(наличия и движения кормов, поголовья, продукции), Снабжение, Планирование, Нормы",\
             "<existing>")
  System_Ext(bi, "Power BI\n[DWH+DataLake+BI]", "Хранилища данных, Отчеты и визуализация","<existing>")

  Rel(center_farm,erp, "Получает/актуализирует данные учёта производственных процессов на фермах")
  Rel(center_farm,bi, "Отправляет значения аналитик мониторинга, получает отчёты")
  Rel(admin,center_farm,"Обеспечивает работу систем и пользователей")
  Rel(admin,farm,"Обеспечивает работу систем и пользователей")
  Rel(mainuser,center_farm,"Управляет фермами")
  Rel(farm,center_farm,"Синхронизация: Приём команд/параметров и распознанных событий из центра, Передача в центр результатов команд и сырых данных/потоков мониторинга")
 }


@enduml