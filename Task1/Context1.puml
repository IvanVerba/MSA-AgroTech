  Person(admin, "Administrator", "IT-администратор системы")
  System(center_ferma, "CenterFerma", "Центральный мониторинг ферм")
  System(agro_tech, "AgroTech", "Центральная платформа АгроТех")
  Rel(admin,ferma,"Manages the system")

  Rel(mainuser,agro_tech,"Управляет фермой в составе центральной платформы")
  Rel(ferma,agro_tech,"Взаимодействуют центр(команды)-ферма(результаты, аналитика)")
 }


